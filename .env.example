# --- Ollama (modelo local; no hace falta API key) ---
# Debe estar corriendo: ollama serve
# Modelo instalado: ollama pull llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- LangSmith EU ---
# Si tu UI es https://eu.smith.langchain.com → usa el endpoint EU
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# De la URL: /o/<ESTE-UUID>/a/<agente>
LANGSMITH_WORKSPACE_ID=01a1c0d5-d5c3-7ed8-b821-a993e8dda091
LANGSMITH_AGENT_ID=sergio
LANGSMITH_AGENT_ENVIRONMENT=production

# --- Tu MCP en Railway ---
MCP_URL=https://mcp-test-production-303973cb.up.railway.app/mcp
